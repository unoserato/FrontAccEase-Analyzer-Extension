{
  "manifest_version": 3,
  "name": "FrontAccEase",
  "version": "1.2",
  "description": "Send webpage HTML and CSS to FrontAccEase for accessibility analysis.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://frontaccease-backend.onrender.com/*",
    "https://8s6nljl6-8000.asse.devtunnels.ms/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_title": "Analyze this page with FrontAccEase",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
